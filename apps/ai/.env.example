# AI Gateway Service Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8100
ENVIRONMENT=development

# Service Authentication (harus sama dengan SERVICE_KEY root / analytics)
SERVICE_KEY=your-service-key-here

# LLM Lokal (workstation HP Z8 G4 / Ollama OpenAI-compatible endpoint)
# Utamakan IP LAN workstation, contoh: http://192.168.1.50:11434/v1
# host.docker.internal dipakai jika Ollama berjalan di host Docker yang sama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:30b-a3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Batasan konteks (minimum data)
LLM_MAX_HISTORY_MESSAGES=20
LLM_MAX_MESSAGE_CHARS=8000

# CORS (origin BFF yang boleh memanggil)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Analytics tools Tahap 2 (spec tahap-2-analytics-tools.md § 5/§ 6)
# Kosong = tools mati (deny-by-default; T11). Aktifkan contoh:
# AI_TOOLS=get_ringkasan_stats,get_keluaran_stats,get_outcome_stats,get_logbook_harian
# ANALYTICS_URL wajib saat tools aktif (alamat analytics di server platform,
# contoh http://10.5.15.80:8000)
ANALYTICS_URL=
AI_TOOLS=
TOOL_MAX_CALLS=2
TOOL_TIMEOUT=15
TOOL_RESULT_MAX_CHARS=4000
