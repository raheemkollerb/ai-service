# Mode B — konfigurasi AI Gateway di HPC (deploy-hpc)
# Salin file ini ke .env (satu folder), isi nilai aslinya, JANGAN commit .env.

# WAJIB — harus SAMA dengan SERVICE_KEY di root .env platform (BFF Express).
SERVICE_KEY=

# server mode
ENVIRONMENT=production

# Runtime LLM lokal di mesin host yang sama (Ollama di HPC).
# Mode B: gateway container → Ollama via host.docker.internal (JALUR lokal HPC,
# tidak melewati LAN). Jangan diisi IP LAN.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:30b-a3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120
