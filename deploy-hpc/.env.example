# Mode B — konfigurasi AI Gateway di HPC (deploy-hpc)
# Salin file ini ke .env (satu folder), isi nilai aslinya, JANGAN commit .env.

# WAJIB — harus SAMA dengan SERVICE_KEY di root .env platform (BFF Express).
SERVICE_KEY=

# server mode
ENVIRONMENT=production

# Runtime LLM lokal di mesin host yang sama (Ollama di HPC).
# Mode B: gateway container → Ollama via host.docker.internal (JALUR lokal HPC,
# tidak melewati LAN). Jangan diisi IP LAN.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:30b-a3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Analytics tools Tahap 2 (spec tahap-2-analytics-tools.md § 5/§ 6)
# Kosong = tools mati (deny-by-default, T11); aktifkan contoh:
# AI_TOOLS=get_ringkasan_stats,get_keluaran_stats,get_outcome_stats,get_logbook_harian
# ANALYTICS_URL wajib saat tools aktif — alamat analytics di server platform
# (inbound TCP 8000 platform hanya untuk IP HPC; lihat spec § 6.1).
# Contoh: http://10.5.15.80:8000
ANALYTICS_URL=
AI_TOOLS=
TOOL_MAX_CALLS=2
TOOL_TIMEOUT=15
TOOL_RESULT_MAX_CHARS=4000
